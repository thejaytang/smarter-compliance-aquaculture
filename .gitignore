# Local environments, generated caches and build products.
**/.venv/
**/.venv.*/
**/.cache/
**/__pycache__/
**/node_modules/
**/.pytest_cache/
**/htmlcov/
**/build/
**/dist/
**/*.egg-info/
*.py[cod]
.coverage
.coverage.*
.DS_Store
**/.DS_Store

# Local execution history, service sessions and generated parsing results.
# Selected importable ZIPs belong in workbench/saved-packages/, outside runtime.
# Runtime exclusion is a Git publication boundary, not a local deletion rule.
**/runtime/
**/tmp/
system2/outputs/
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.ses
*.log

# Local secrets and editor state. Keep sanitized examples only.
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
*.pem
*.key
.idea/
.vscode/
.playwright-cli/
**/model-provider.local.json
**/machine-assessment-rules.local.json
**/scoring-rules.local.json

# Bundled PDF.js runtime assets are required in portable checkouts.
!**/vendor/pdfjs/build/
!**/vendor/pdfjs/build/**

# Local environment links and live coordination locks are not portable.
**/.venv
**/.system1-source-management.lock

