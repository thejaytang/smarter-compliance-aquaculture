      },
      "role": "requirement_id",
      "object_kind": "table_cell",
      "segment_order": 10,
      "source_text": "2.6.16"
    },
    {
      "segment_id": "p055-r2.6.16-root",
      "page_number": 55,
      "page_index": 54,
      "page_size": {
        "width": 595.32,
