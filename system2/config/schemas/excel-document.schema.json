{
  "$defs": {
    "ExcelCell": {
      "additionalProperties": false,
      "properties": {
        "coordinate": {
          "title": "Coordinate",
          "type": "string"
        },
        "locator": {
          "title": "Locator",
          "type": "string"
        },
        "attributes": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Attributes",
          "type": "object"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Text"
        },
        "formula": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Formula"
        },
        "formula_attributes": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Formula Attributes"
        },
        "cache_status": {
          "enum": [
            "not_formula",
            "present",
            "missing"
          ],
          "title": "Cache Status",
          "type": "string"
        },
        "source_xml": {
          "title": "Source Xml",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "review_policy": {
          "const": "review_required",
          "default": "review_required",
          "title": "Review Policy",
          "type": "string"
        }
      },
      "required": [
        "coordinate",
        "locator",
        "attributes",
        "value",
        "text",
        "formula",
        "formula_attributes",
        "cache_status",
        "source_xml"
      ],
      "title": "ExcelCell",
      "type": "object"
    },
    "ExcelPart": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "size": {
          "title": "Size",
          "type": "integer"
        },
        "xml": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Xml"
        }
      },
      "required": [
        "path",
        "sha256",
        "size"
      ],
      "title": "ExcelPart",
      "type": "object"
    },
    "ExcelSheet": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "sheet_id": {
          "title": "Sheet Id",
          "type": "string"
        },
        "state": {
          "title": "State",
          "type": "string"
        },
        "part": {
          "title": "Part",
          "type": "string"
        },
        "attributes": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Attributes",
          "type": "object"
        },
        "worksheet_attributes": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Worksheet Attributes",
          "type": "object"
        },
        "cells": {
          "items": {
            "$ref": "#/$defs/ExcelCell"
          },
          "title": "Cells",
          "type": "array"
        },
        "rows": {
          "items": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "title": "Rows",
          "type": "array"
        },
        "merged_ranges": {
          "items": {
            "type": "string"
          },
          "title": "Merged Ranges",
          "type": "array"
        },
        "structure_xml": {
          "items": {
            "type": "string"
          },
          "title": "Structure Xml",
          "type": "array"
        },
        "confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "review_policy": {
          "const": "review_required",
          "default": "review_required",
          "title": "Review Policy",
          "type": "string"
        }
      },
      "required": [
        "name",
        "sheet_id",
        "state",
        "part",
        "attributes",
        "worksheet_attributes",
        "cells",
        "rows",
        "merged_ranges",
        "structure_xml"
      ],
      "title": "ExcelSheet",
      "type": "object"
    },
    "LocalExcelSource": {
      "additionalProperties": false,
      "properties": {
        "source_kind": {
          "const": "local_diagnostic",
          "default": "local_diagnostic",
          "title": "Source Kind",
          "type": "string"
        },
        "relative_path": {
          "title": "Relative Path",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "file_format": {
          "const": "xlsx",
          "default": "xlsx",
          "title": "File Format",
          "type": "string"
        },
        "production_eligible": {
          "const": false,
          "default": false,
          "title": "Production Eligible",
          "type": "boolean"
        }
      },
      "required": [
        "relative_path",
        "content_hash"
      ],
      "title": "LocalExcelSource",
      "type": "object"
    },
    "Snapshot": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "pattern": "^[A-Z]{2}\\d{3}$",
          "title": "Source Id",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^[A-Z]{2}\\d{3}-\\d{3}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "relative_path": {
          "title": "Relative Path",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "file_format": {
          "title": "File Format",
          "type": "string"
        },
        "operator_selection_decision": {
          "const": "INCLUDE",
          "title": "Operator Selection Decision",
          "type": "string"
        },
        "selection_status": {
          "const": "INCLUDE",
          "title": "Selection Status",
          "type": "string"
        },
        "snapshot_status": {
          "const": "STORED",
          "title": "Snapshot Status",
          "type": "string"
        },
        "source_status": {
          "const": "CURRENT",
          "title": "Source Status",
          "type": "string"
        },
        "download_status": {
          "const": "SUCCESS",
          "title": "Download Status",
          "type": "string"
        },
        "registry_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Registry Sha256",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "snapshot_id",
        "relative_path",
        "content_hash",
        "file_format",
        "operator_selection_decision",
        "selection_status",
        "snapshot_status",
        "source_status",
        "download_status",
        "registry_sha256"
      ],
      "title": "Snapshot",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "excel-document/1",
      "default": "excel-document/1",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "anyOf": [
        {
          "$ref": "#/$defs/Snapshot"
        },
        {
          "$ref": "#/$defs/LocalExcelSource"
        }
      ],
      "title": "Source"
    },
    "parser_version": {
      "default": "xlsx-ooxml/1.1.0",
      "title": "Parser Version",
      "type": "string"
    },
    "config_hash": {
      "title": "Config Hash",
      "type": "string"
    },
    "workbook_attributes": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Workbook Attributes",
      "type": "object"
    },
    "sheets": {
      "items": {
        "$ref": "#/$defs/ExcelSheet"
      },
      "title": "Sheets",
      "type": "array"
    },
    "workbook_structure_xml": {
      "items": {
        "type": "string"
      },
      "title": "Workbook Structure Xml",
      "type": "array"
    },
    "parts": {
      "items": {
        "$ref": "#/$defs/ExcelPart"
      },
      "title": "Parts",
      "type": "array"
    },
    "issues": {
      "items": {
        "type": "string"
      },
      "title": "Issues",
      "type": "array"
    },
    "confidence": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confidence"
    },
    "review_policy": {
      "const": "review_required",
      "default": "review_required",
      "title": "Review Policy",
      "type": "string"
    },
    "requirement_status": {
      "const": "not_extracted",
      "default": "not_extracted",
      "title": "Requirement Status",
      "type": "string"
    }
  },
  "required": [
    "source",
    "config_hash",
    "workbook_attributes",
    "sheets",
    "workbook_structure_xml",
    "parts"
  ],
  "title": "ExcelDocument",
  "type": "object"
}
