          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "review_policy": {
          "const": "review_required",
          "default": "review_required",
          "title": "Review Policy",
          "type": "string"
        }
