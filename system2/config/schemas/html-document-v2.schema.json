{
  "$defs": {
    "HtmlAtom": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "node_id": {
          "title": "Node Id",
          "type": "string"
        },
        "text_index": {
          "minimum": 1,
          "title": "Text Index",
          "type": "integer"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "review_policy": {
          "const": "review_required",
          "default": "review_required",
          "title": "Review Policy",
          "type": "string"
        }
      },
      "required": [
        "id",
        "node_id",
        "text_index",
        "text"
      ],
      "title": "HtmlAtom",
      "type": "object"
    },
