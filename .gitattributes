# Predictable script line endings across platforms.
*.py text eol=lf
*.sh text eol=lf
*.command text eol=lf
*.cmd text eol=crlf

# Preserve the complete legal original byte-for-byte on every platform.
workbench/resources/examples/example.html -text

# Preserve original and bundled third-party bytes.
workbench/workspace/** -text
workbench/frontend/assets/vendor/** -text
*.zip -text

# Preserve PDF byte offsets and treat PDF assets as binary.
*.pdf binary

# Preserve historical evidence and original test-fixture bytes on this branch.
project-support/** -text
workbench/tests/**/fixtures/** -text
