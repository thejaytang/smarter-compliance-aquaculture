    {
      "id": "block-52eb621da8cdde48d325cfaf",
      "type": "text",
      "text": "NATIONAL LAWS AND LOCAL REGULATIONS",
      "level": 1,
      "parent_id": null,
      "numbering": "",
      "dependencies": [],
      "source_refs": [
        {
          "scope_id": "page:18",
          "page_index": 17,
          "page": 18,
