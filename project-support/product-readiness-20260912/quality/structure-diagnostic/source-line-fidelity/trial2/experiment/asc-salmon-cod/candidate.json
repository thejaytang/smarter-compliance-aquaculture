          ],
          "native_id": "native_p0000_ft000017"
        }
      ]
    },
    {
      "id": "block-4baeb23cc0d49ee644d869f7",
      "type": "text",
      "text": "Principle 1 is intended to ensure that all farms aiming to be certified against the ASC\nSalmon Standard standards meet their legal obligations as a baseline requirement.",
      "level": 1,
      "parent_id": null,
      "numbering": "",
      "dependencies": [],
      "source_refs": [
        {
          "scope_id": "page:18",
          "page_index": 17,
          "page": 18,
          "bbox": [
            57.8985595703125,
            120.4130859375,
            555.716796875,
            130.84588623046875
          ],
          "native_id": "native_p0000_ft000018"
        },
        {
          "scope_id": "page:18",
          "page_index": 17,
          "page": 18,
          "bbox": [
            57.158878326416016,
            136.54833984375,
            555.4130249023438,
            146.9259033203125
          ],
          "native_id": "native_p0000_ft000019"
        }
      ]
    },
    {
      "id": "block-b792e2f98b984fab236fbac2",
      "type": "text",
      "text": "Adhering to the law will ensure that producers meet the basic environmental and social\nrequirements and the minimal structures, such as legitimate land tenure rights, on which\nthe effectiveness of the requirements will stand.",
      "level": 1,
      "parent_id": null,
      "numbering": "",
      "dependencies": [],
      "source_refs": [
        {
          "scope_id": "page:18",
          "page_index": 17,
          "page": 18,
          "bbox": [
            56.662078857421875,
            152.62835693359375,
            555.3167114257812,
            163.00592041015625
          ],
          "native_id": "native_p0000_ft000020"
        },
        {
