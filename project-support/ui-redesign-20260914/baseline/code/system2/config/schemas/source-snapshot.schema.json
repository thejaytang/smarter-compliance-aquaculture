{
  "$defs": {
    "ConversionLineage": {
      "additionalProperties": false,
      "properties": {
        "original_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Original Sha256",
          "type": "string"
        },
        "original_format": {
          "title": "Original Format",
          "type": "string"
        },
        "conversion_id": {
          "title": "Conversion Id",
          "type": "string"
        },
        "operator": {
          "title": "Operator",
          "type": "string"
        },
        "method": {
          "title": "Method",
          "type": "string"
        },
        "completeness_note": {
          "title": "Completeness Note",
          "type": "string"
        }
      },
      "required": [
        "original_sha256",
        "original_format",
        "conversion_id",
        "operator",
        "method",
        "completeness_note"
      ],
      "title": "ConversionLineage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "source_id": {
      "pattern": "^[A-Z]{2}\\d{3}$",
      "title": "Source Id",
      "type": "string"
    },
    "snapshot_id": {
      "pattern": "^[A-Z]{2}\\d{3}-\\d{3}$",
      "title": "Snapshot Id",
      "type": "string"
    },
    "relative_path": {
      "title": "Relative Path",
      "type": "string"
    },
    "content_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "file_format": {
      "title": "File Format",
      "type": "string"
    },
    "operator_selection_decision": {
      "enum": [
        "INCLUDE",
        "PENDING"
      ],
      "title": "Operator Selection Decision",
      "type": "string"
    },
    "selection_origin": {
      "default": "human",
      "enum": [
        "human",
        "machine"
      ],
      "title": "Selection Origin",
      "type": "string"
    },
    "assessment_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Assessment Id"
    },
    "parsing_copy_of": {
      "anyOf": [
        {
          "$ref": "#/$defs/ConversionLineage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "selection_status": {
      "const": "INCLUDE",
      "title": "Selection Status",
      "type": "string"
    },
    "snapshot_status": {
      "const": "STORED",
      "title": "Snapshot Status",
      "type": "string"
    },
    "source_status": {
      "const": "CURRENT",
      "title": "Source Status",
      "type": "string"
    },
    "download_status": {
      "const": "SUCCESS",
      "title": "Download Status",
      "type": "string"
    },
    "registry_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Registry Sha256",
      "type": "string"
    },
    "registry_kind": {
      "default": "workbook",
      "enum": [
        "workbook",
        "sqlite_snapshot"
      ],
      "title": "Registry Kind",
      "type": "string"
    }
  },
  "required": [
    "source_id",
    "snapshot_id",
    "relative_path",
    "content_hash",
    "file_format",
    "operator_selection_decision",
    "selection_status",
    "snapshot_status",
    "source_status",
    "download_status",
    "registry_sha256"
  ],
  "title": "Snapshot",
  "type": "object"
}
