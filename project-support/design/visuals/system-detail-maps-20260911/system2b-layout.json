      "y": 672.0,
      "w": 532.0,
      "h": 125.99999999999999,
      "decision": true
    },
    {
      "module": 4,
      "row": 3,
      "title": "03 \u00b7 Compose a parent envelope",
      "body": "Full parent and nested subitems remain together with one declared count basis.",
      "x": 3017.0,
      "y": 854.0,
      "w": 532.0,
      "h": 125.99999999999999,
      "decision": false
    },
    {
      "module": 4,
      "row": 4,
      "title": "04 \u00b7 Publish counted Requirements",
