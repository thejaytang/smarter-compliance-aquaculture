  "nodes": [
    {
      "module": 1,
      "row": 1,
      "title": "01 \u00b7 A source and context accepted?",
      "body": "Require current complete text, structure, coverage and dependencies.",
      "x": 98.0,
      "y": 489.99999999999994,
      "w": 532.0,
      "h": 125.99999999999999,
      "decision": true
    },
    {
      "module": 1,
      "row": 2,
      "title": "02 \u00b7 Coverage or assembly view?",
      "body": "A coverage checklist / table assembly is context, not a duplicate obligation.",
      "x": 98.0,
      "y": 672.0,
      "w": 532.0,
      "h": 125.99999999999999,
      "decision": true
    },
    {
      "module": 1,
      "row": 3,
      "title": "03 \u00b7 Operative wording present?",
      "body": "Normative or advisory wording proposes a Requirement; role still needs review.",
      "x": 98.0,
      "y": 854.0,
      "w": 532.0,
      "h": 125.99999999999999,
      "decision": true
    },
    {
      "module": 1,
      "row": 4,
      "title": "04 \u00b7 Applicability / exemption rule?",
      "body": "Retain the full controlling clause and its scope as a Requirement candidate.",
      "x": 98.0,
      "y": 1036.0,
      "w": 532.0,
      "h": 125.99999999999999,
      "decision": true
    },
    {
      "module": 1,
      "row": 5,
      "title": "05 \u00b7 Numbered standard item?",
      "body": "A principle / indicator can propose a Requirement, subject to its actual role.",
      "x": 98.0,
      "y": 1218.0,
      "w": 532.0,
      "h": 125.99999999999999,
      "decision": true
    },
    {
      "module": 1,
      "row": 6,
      "title": "06 \u00b7 Definition, heading or support?",
      "body": "A modal definition, non-operative heading, citation or support contact is context.",
      "x": 98.0,
      "y": 1400.0,
      "w": 532.0,
      "h": 125.99999999999999,
      "decision": true
    },
    {
      "module": 1,
      "row": 7,
      "title": "07 \u00b7 No conclusive local evidence",
      "body": "Return UNDETERMINED with the matched evidence and a concise reason.",
      "x": 98.0,
      "y": 1582.0,
      "w": 532.0,
      "h": 125.99999999999999,
      "decision": false
    },
    {
      "module": 2,
      "row": 1,
      "title": "01 \u00b7 Bring proposals together",
      "body": "Requirement, context and undetermined proposals all keep source evidence.",
      "x": 1071.0,
      "y": 489.99999999999994,
      "w": 532.0,
      "h": 125.99999999999999,
      "decision": false
    },
    {
      "module": 2,
      "row": 2,
      "title": "02 \u00b7 Attach original context",
      "body": "Full parent, numbering, definitions, headings, notes and table relationships.",
      "x": 1071.0,
      "y": 672.0,
      "w": 532.0,
      "h": 125.99999999999999,
      "decision": false
    },
    {
      "module": 2,
      "row": 3,
      "title": "03 \u00b7 Check source association",
      "body": "Confirm that conditions and references belong to this statement and version.",
      "x": 1071.0,
      "y": 854.0,
      "w": 532.0,
      "h": 125.99999999999999,
      "decision": false
    },
    {
      "module": 2,
      "row": 4,
      "title": "04 \u00b7 Check three B dimensions",
      "body": "Classification, association and subdivision need supported evidence/confidence.",
      "x": 1071.0,
      "y": 1036.0,
      "w": 532.0,
      "h": 125.99999999999999,
      "decision": false
    },
    {
      "module": 2,
      "row": 5,
      "title": "05 \u00b7 Review the proposed meaning",
      "body": "A human can select Requirement, context, non-Requirement or undetermined.",
      "x": 1071.0,
      "y": 1218.0,
      "w": 532.0,
      "h": 125.99999999999999,
      "decision": false
    },
    {
      "module": 2,
      "row": 6,
      "title": "06 \u00b7 Record decision and reason",
      "body": "Exclusions need a reason; advisory character remains distinguishable.",
      "x": 1071.0,
      "y": 1400.0,
      "w": 532.0,
      "h": 125.99999999999999,
      "decision": false
    },
    {
      "module": 2,
      "row": 7,
      "title": "07 \u00b7 Requirement to represent?",
      "body": "Only a current Requirement enters optional subdivision and delivery.",
      "x": 1071.0,
      "y": 1582.0,
      "w": 532.0,
      "h": 125.99999999999999,
      "decision": true
    },
    {
      "module": 3,
      "row": 1,
      "title": "01 \u00b7 Preserve the complete parent",
      "body": "Keep full accepted A content, original number, source version and context.",
      "x": 2043.9999999999998,
      "y": 489.99999999999994,
      "w": 532.0,
      "h": 125.99999999999999,
      "decision": false
    },
    {
      "module": 3,
      "row": 2,
      "title": "02 \u00b7 Is subdivision appropriate?",
      "body": "Whole-table containers cannot duplicate already identified source-row items.",
      "x": 2043.9999999999998,
      "y": 672.0,
      "w": 532.0,
      "h": 125.99999999999999,
      "decision": true
    },
    {
      "module": 3,
      "row": 3,
      "title": "03 \u00b7 Select exact accepted spans",
      "body": "Children use nonempty, non-overlapping quotations; source text stays intact.",
      "x": 2043.9999999999998,
      "y": 854.0,
      "w": 532.0,
      "h": 125.99999999999999,
      "decision": false
    },
    {
      "module": 3,
      "row": 4,
      "title": "04 \u00b7 Inspect all remaining text",
      "body": "Unassigned substantive text needs an explicit explanation and whole-parent review.",
      "x": 2043.9999999999998,
      "y": 1036.0,
      "w": 532.0,
      "h": 125.99999999999999,
      "decision": false
    },
    {
      "module": 3,
      "row": 5,
      "title": "05 \u00b7 Attach shared conditions",
      "body": "Keep inherited context; generated labels stay separate from original numbering.",
      "x": 2043.9999999999998,
      "y": 1218.0,
      "w": 532.0,
      "h": 125.99999999999999,
      "decision": false
    },
    {
      "module": 3,
      "row": 6,
      "title": "06 \u00b7 Choose one counting basis",
      "body": "Count the parent once OR counted children. Never count both.",
      "x": 2043.9999999999998,
      "y": 1400.0,
      "w": 532.0,
      "h": 125.99999999999999,
      "decision": false
    },
    {
      "module": 3,
      "row": 7,
      "title": "07 \u00b7 Save a reversible B decision",
      "body": "Keep spans, count policy and prior revisions. Clearing needs parent classification.",
      "x": 2043.9999999999998,
      "y": 1582.0,
      "w": 532.0,
      "h": 125.99999999999999,
      "decision": false
    },
    {
      "module": 4,
      "row": 1,
      "title": "01 \u00b7 Recheck all current gates",
