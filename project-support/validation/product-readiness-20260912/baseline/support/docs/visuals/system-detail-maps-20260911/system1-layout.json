{
  "key": "system1",
  "title": "System1 | Govern the source, version and admission",
  "size": [
    3919.9999999999995,
    2940.0
  ],
  "nodes": [
    {
      "module": 1,
      "row": 1,
      "title": "01 \u00b7 Registered identity?",
      "body": "Distinguish existing governed sources from new proposals.",
      "x": 98.0,
      "y": 489.99999999999994,
      "w": 532.0,
      "h": 125.99999999999999,
      "decision": true
    },
    {
      "module": 1,
      "row": 2,
      "title": "02 \u00b7 Receive a candidate",
      "body": "Authorised local file or structured candidate; record its origin.",
      "x": 98.0,
      "y": 672.0,
      "w": 532.0,
      "h": 125.99999999999999,
      "decision": false
    },
    {
      "module": 1,
      "row": 3,
      "title": "03 \u00b7 Compare identities",
      "body": "Check duplicate official identities and missing source fields.",
      "x": 98.0,
      "y": 854.0,
      "w": 532.0,
      "h": 125.99999999999999,
      "decision": true
    },
    {
      "module": 1,
      "row": 4,
      "title": "04 \u00b7 Complete the proposal",
      "body": "Locate the official source, retrieval target, format and provenance.",
      "x": 98.0,
      "y": 1036.0,
      "w": 532.0,
      "h": 125.99999999999999,
      "decision": false
    },
    {
      "module": 1,
      "row": 5,
      "title": "05 \u00b7 Named human ACCEPT?",
      "body": "Admission is explicit; ordinary ratings do not create a source.",
      "x": 98.0,
      "y": 1218.0,
      "w": 532.0,
      "h": 125.99999999999999,
      "decision": true
    },
    {
      "module": 1,
      "row": 6,
      "title": "06 \u00b7 Register the source",
      "body": "Assign the formal source identity and retain the admission decision.",
      "x": 98.0,
      "y": 1400.0,
      "w": 532.0,
      "h": 125.99999999999999,
      "decision": false
    },
    {
      "module": 1,
      "row": 7,
      "title": "07 \u00b7 Queue eligible retrieval",
      "body": "Existing and newly admitted current records join the same route.",
      "x": 98.0,
      "y": 1582.0,
      "w": 532.0,
      "h": 125.99999999999999,
      "decision": false
    },
    {
      "module": 2,
      "row": 1,
      "title": "01 \u00b7 Resolve retrieval target",
      "body": "Official identity and retrievable original are separate concepts.",
      "x": 1071.0,
      "y": 489.99999999999994,
      "w": 532.0,
      "h": 125.99999999999999,
      "decision": false
    },
    {
      "module": 2,
      "row": 2,
      "title": "02 \u00b7 Acquire the original",
      "body": "Keep authoritative language and original published format.",
      "x": 1071.0,
      "y": 672.0,
      "w": 532.0,
      "h": 125.99999999999999,
      "decision": false
    },
    {
      "module": 2,
      "row": 3,
      "title": "03 \u00b7 Usable payload?",
      "body": "Check format, expected file evidence and failed/restricted access.",
      "x": 1071.0,
      "y": 854.0,
      "w": 532.0,
      "h": 125.99999999999999,
      "decision": true
    },
    {
      "module": 2,
      "row": 4,
      "title": "04 \u00b7 Compare current version",
      "body": "Compare exact source bytes with the retained snapshot.",
      "x": 1071.0,
      "y": 1036.0,
      "w": 532.0,
      "h": 125.99999999999999,
      "decision": true
    },
    {
      "module": 2,
      "row": 5,
      "title": "05 \u00b7 Retain a new snapshot",
      "body": "Keep the previous original; attach provenance and version lineage.",
      "x": 1071.0,
      "y": 1218.0,
      "w": 532.0,
      "h": 125.99999999999999,
      "decision": false
    },
    {
      "module": 2,
      "row": 6,
      "title": "06 \u00b7 Record acquisition state",
      "body": "Success, failure and restricted access remain distinct from selection.",
      "x": 1071.0,
      "y": 1400.0,
      "w": 532.0,
      "h": 125.99999999999999,
      "decision": false
    },
    {
      "module": 2,
      "row": 7,
      "title": "07 \u00b7 Return current evidence",
      "body": "Expose the valid snapshot, version, access result and any open issue.",
      "x": 1071.0,
      "y": 1582.0,
      "w": 532.0,
      "h": 125.99999999999999,
      "decision": false
    },
    {
      "module": 3,
      "row": 1,
      "title": "01 \u00b7 Preserve human decisions",
      "body": "Read the current selection, named decisions, reports and drafts.",
      "x": 2043.9999999999998,
      "y": 489.99999999999994,
      "w": 532.0,
      "h": 125.99999999999999,
      "decision": false
    },
    {
      "module": 3,
      "row": 2,
      "title": "02 \u00b7 Assess five dimensions",
      "body": "Authority, relevance, currency, traceability and access permission.",
      "x": 2043.9999999999998,
      "y": 672.0,
      "w": 532.0,
      "h": 125.99999999999999,
      "decision": false
    },
    {
      "module": 3,
      "row": 3,
      "title": "03 \u00b7 Evidence supports scores?",
      "body": "Each dimension needs scoped evidence and calibrated confidence.",
      "x": 2043.9999999999998,
      "y": 854.0,
      "w": 532.0,
      "h": 125.99999999999999,
      "decision": true
    },
    {
      "module": 3,
      "row": 4,
      "title": "04 \u00b7 All machine gates pass?",
      "body": "Five HIGH ratings, threshold support, valid original and no hold.",
      "x": 2043.9999999999998,
      "y": 1036.0,
      "w": 532.0,
      "h": 125.99999999999999,
      "decision": true
    },
    {
      "module": 3,
      "row": 5,
      "title": "05 \u00b7 Resolve effective selection",
      "body": "Retain human precedence; machine admission never invents a reviewer.",
      "x": 2043.9999999999998,
      "y": 1218.0,
      "w": 532.0,
      "h": 125.99999999999999,
      "decision": false
    },
    {
      "module": 3,
      "row": 6,
      "title": "06 \u00b7 Audit + weekly source QA",
      "body": "Check source/file consistency. Monday sample: 5 eligible records.",
      "x": 2043.9999999999998,
      "y": 1400.0,
      "w": 532.0,
      "h": 125.99999999999999,
      "decision": false
    },
    {
      "module": 3,
      "row": 7,
      "title": "07 \u00b7 INCLUDE and current?",
      "body": "Only effective INCLUDE with a usable current snapshot moves on.",
      "x": 2043.9999999999998,
      "y": 1582.0,
      "w": 532.0,
      "h": 125.99999999999999,
      "decision": true
    },
    {
      "module": 4,
      "row": 1,
      "title": "01 \u00b7 Bind the source package",
      "body": "Source identity + original + version + selection and acquisition state.",
      "x": 3017.0,
      "y": 489.99999999999994,
      "w": 532.0,
      "h": 125.99999999999999,
      "decision": false
    },
    {
      "module": 4,
      "row": 2,
      "title": "02 \u00b7 Recheck current evidence",
      "body": "Reject changed bytes or stale eligibility before a downstream start.",
      "x": 3017.0,
      "y": 672.0,
      "w": 532.0,
      "h": 125.99999999999999,
      "decision": true
    },
    {
      "module": 4,
      "row": 3,
      "title": "03 \u00b7 Expose the eligible original",
      "body": "System2A starts only on explicit user action; opening a view does not start it.",
      "x": 3017.0,
      "y": 854.0,
      "w": 532.0,
      "h": 125.99999999999999,
      "decision": false
    },
    {
      "module": 4,
      "row": 4,
      "title": "04 \u00b7 Publish the source register",
      "body": "One-way Excel snapshot of the owning saved source state.",
      "x": 3017.0,
      "y": 1036.0,
      "w": 532.0,
      "h": 125.99999999999999,
      "decision": false
    },
    {
      "module": 4,
      "row": 5,
      "title": "05 \u00b7 Reconcile output status",
      "body": "Saved, export-pending, synchronized and failed are separate states.",
      "x": 3017.0,
      "y": 1218.0,
      "w": 532.0,
      "h": 125.99999999999999,
      "decision": false
    },
    {
      "module": 4,
      "row": 6,
      "title": "06 \u00b7 Process downstream follow-up",
      "body": "Missing body or source defect returns to the existing source task.",
      "x": 3017.0,
      "y": 1400.0,
      "w": 532.0,
      "h": 125.99999999999999,
      "decision": false
    },
    {
      "module": 4,
      "row": 7,
      "title": "07 \u00b7 Preserve continuity",
      "body": "New source versions or loss of eligibility suspend affected downstream use.",
      "x": 3017.0,
      "y": 1582.0,
      "w": 532.0,
      "h": 125.99999999999999,
      "decision": false
    },
    {
      "module": 1,
      "row": 1,
      "title": "Retain identity",
      "body": "Keep previous decisions; use the existing retrieval route.",
      "x": 672.0,
      "y": 487.2,
      "w": 230.99999999999997,
      "h": 138.6,
      "branch": true
    },
    {
      "module": 1,
      "row": 3,
      "title": "Reconcile first",
      "body": "Keep one source identity. Resolve the proposed link or metadata.",
      "x": 672.0,
      "y": 851.1999999999999,
      "w": 230.99999999999997,
      "h": 138.6,
      "branch": true
    },
    {
      "module": 1,
      "row": 5,
      "title": "Remain a candidate",
      "body": "Pending or declined admission retains its reason.",
      "x": 672.0,
      "y": 1215.1999999999998,
      "w": 230.99999999999997,
      "h": 138.6,
      "branch": true
    },
    {
      "module": 2,
      "row": 3,
      "title": "Preserve valid file",
      "body": "Paywall/failure: record evidence and request an authorised original.",
      "x": 1645.0,
      "y": 851.1999999999999,
      "w": 230.99999999999997,
      "h": 138.6,
      "branch": true
    },
    {
      "module": 2,
      "row": 4,
      "title": "Reuse snapshot",
      "body": "Record the check; avoid creating a duplicate source version.",
      "x": 1645.0,
      "y": 1033.2,
      "w": 230.99999999999997,
      "h": 138.6,
      "branch": true
    },
    {
      "module": 3,
      "row": 3,
      "title": "Human assessment",
      "body": "Unknown stays unknown; no invented percentage.",
      "x": 2618.0,
      "y": 851.1999999999999,
      "w": 230.99999999999997,
      "h": 138.6,
      "branch": true
    },
    {
      "module": 3,
      "row": 4,
      "title": "Keep the hold",
      "body": "Low score, source failure or human follow-up needs action.",
      "x": 2618.0,
      "y": 1033.2,
      "w": 230.99999999999997,
      "h": 138.6,
      "branch": true
    },
