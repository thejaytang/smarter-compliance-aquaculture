          "role": "normative_text",
          "page_index": 28,
          "target": "The UoC shall appoint at least one member of management responsible for the implementation of the ASC Requirements.",
          "complete_in_page": true,
          "single_block_before_grouping": false,
          "single_block_after_grouping": true
        },
        {
          "id": "farm-p029-r1.2.3-id",
