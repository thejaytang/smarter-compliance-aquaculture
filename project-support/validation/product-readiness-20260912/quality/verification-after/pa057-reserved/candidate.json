            538.6794128417969
          ],
          "native_id": "native_p0001_ft000026"
        }
      ]
    },
    {
      "id": "block-c940d1845c2230e36952db25",
      "type": "text",
      "text": "eventuelt ekstrautstyr hvor det produseres fisk.",
      "level": 1,
      "parent_id": null,
      "numbering": "",
      "dependencies": [],
      "source_refs": [
        {
          "scope_id": "page:6",
          "page_index": 5,
          "page": 6,
          "bbox": [
