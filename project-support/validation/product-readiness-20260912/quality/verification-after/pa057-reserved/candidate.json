      ]
    },
    {
      "id": "block-38569ec88dd8473c1219fc61",
      "type": "text",
      "text": "Produksjonsenhet: kar med tilhørende siler, dødfisksystem, oversvømmingssperre og",
      "level": 1,
      "parent_id": null,
      "numbering": "",
      "dependencies": [],
      "source_refs": [
        {
          "scope_id": "page:6",
          "page_index": 5,
          "page": 6,
          "bbox": [
