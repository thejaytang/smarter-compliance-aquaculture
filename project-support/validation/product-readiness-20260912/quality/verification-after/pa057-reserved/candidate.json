            516.1670532226562,
            600.0489807128906
          ],
          "native_id": "native_p0001_ft000031"
        }
      ]
    },
    {
      "id": "block-9b077e0d8e1e32646f882b43",
      "type": "text",
      "text": "på enheten.",
      "level": 1,
      "parent_id": null,
      "numbering": "",
      "dependencies": [],
      "source_refs": [
        {
          "scope_id": "page:6",
          "page_index": 5,
          "page": 6,
          "bbox": [
