          "native_id": "native_p0001_ft000036"
        }
      ]
    },
    {
      "id": "block-6644e3269aa1d032d51dd9e6",
      "type": "text",
      "text": "Referansenivå: en beskrivelse av ønsket tilstand for et byggverk, en bygningsdel eller et",
      "level": 1,
      "parent_id": null,
      "numbering": "",
      "dependencies": [],
      "source_refs": [
