          "native_id": "native_p0001_ft000035"
        }
      ]
    },
    {
      "id": "block-69961ba6a15aa0997a01c575",
      "type": "text",
      "text": "Prosjektering: utforming, dimensjonering og planlegging av utførelse.",
      "level": 1,
      "parent_id": null,
      "numbering": "",
      "dependencies": [],
      "source_refs": [
        {
