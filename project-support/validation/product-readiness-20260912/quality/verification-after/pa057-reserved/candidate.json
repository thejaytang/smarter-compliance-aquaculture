          ],
          "native_id": "native_p0001_ft000027"
        }
      ]
    },
    {
      "id": "block-7612aaf1ba1770354f03e0ea",
      "type": "text",
      "text": "Produksjonsenhet er i akvakulturdriftsforskriften definert som «merd, kar, dam,",
      "level": 1,
      "parent_id": null,
      "numbering": "",
      "dependencies": [],
      "source_refs": [
        {
          "scope_id": "page:6",
          "page_index": 5,
          "page": 6,
          "bbox": [
            177.49700927734375,
            567.8199768066406,
            514.366943359375,
            576.6489562988281
          ],
          "native_id": "native_p0001_ft000029"
        }
      ]
    },
    {
      "id": "block-d6a6c87657b4015a1672ceee",
      "type": "text",
      "text": "MERKNAD:",
      "level": 1,
      "parent_id": null,
      "numbering": "",
      "dependencies": [],
      "source_refs": [
        {
          "scope_id": "page:6",
          "page_index": 5,
          "page": 6,
          "bbox": [
