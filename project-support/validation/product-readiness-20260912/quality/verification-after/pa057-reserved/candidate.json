          "native_id": "native_p0001_ft000028"
        }
      ]
    },
    {
      "id": "block-1e4889f332699ff27e167418",
      "type": "text",
      "text": "bur, poser, avstengning og lignende.». I denne veilederen forstås",
      "level": 1,
      "parent_id": null,
      "numbering": "",
      "dependencies": [],
      "source_refs": [
        {
          "scope_id": "page:6",
          "page_index": 5,
          "page": 6,
          "bbox": [
