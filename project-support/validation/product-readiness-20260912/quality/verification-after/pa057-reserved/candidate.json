    },
    {
      "id": "block-21cbe2e193760a9285730b93",
      "type": "text",
      "text": "Landbasert akvakulturanlegg: produksjonsanlegg for akvakultur med fisk som er plassert",
      "level": 1,
      "parent_id": null,
      "numbering": "",
      "dependencies": [],
      "source_refs": [
        {
          "scope_id": "page:6",
          "page_index": 5,
          "page": 6,
