            497.9994201660156
          ],
          "native_id": "native_p0001_ft000024"
        }
      ]
    },
    {
      "id": "block-93fc43c8129737d44a12faa5",
      "type": "text",
      "text": "akvakulturanlegget for fisk frem til mottak i brønnbåt, bil eller liknende.",
      "level": 1,
      "parent_id": null,
      "numbering": "",
      "dependencies": [],
      "source_refs": [
        {
          "scope_id": "page:6",
          "page_index": 5,
          "page": 6,
          "bbox": [
