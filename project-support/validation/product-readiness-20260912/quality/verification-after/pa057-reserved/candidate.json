          "native_id": "native_p0001_ft000033"
        }
      ]
    },
    {
      "id": "block-dc58877208e6717ce382d860",
      "type": "text",
      "text": "internasjonal standard eller annen teknisk spesifikasjon, og at produksjonen er",
      "level": 1,
      "parent_id": null,
      "numbering": "",
      "dependencies": [],
      "source_refs": [
        {
          "scope_id": "page:6",
          "page_index": 5,
