            225.67401123046875,
            611.7009887695312
          ],
          "native_id": "native_p0001_ft000032"
        }
      ]
    },
    {
      "id": "block-d476da5d70caa8a50400fb6d",
      "type": "text",
      "text": "Produktsertifikat: sertifikat som angir at produktet er i samsvar med nasjonal eller",
      "level": 1,
      "parent_id": null,
      "numbering": "",
      "dependencies": [],
      "source_refs": [
        {
          "scope_id": "page:6",
          "page_index": 5,
          "page": 6,
