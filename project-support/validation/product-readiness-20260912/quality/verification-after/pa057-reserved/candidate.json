            579.3459777832031,
            448.55010986328125,
            588.4089813232422
          ],
          "native_id": "native_p0001_ft000030"
        }
      ]
    },
    {
      "id": "block-ff4f8e69105b519b5b3423fb",
      "type": "text",
      "text": "produksjonsenhet som hele enheten hvor fisk produseres, inkludert utstyr festet",
      "level": 1,
      "parent_id": null,
      "numbering": "",
      "dependencies": [],
      "source_refs": [
        {
          "scope_id": "page:6",
          "page_index": 5,
          "page": 6,
          "bbox": [
