          "native_id": "native_p0001_ft000023"
        }
      ]
    },
    {
      "id": "block-87593c9aed6cc6340f0b2dcf",
      "type": "text",
      "text": "Leveringssystem: slanger og rørsystemer fra et sikret område på det landbaserte",
      "level": 1,
      "parent_id": null,
      "numbering": "",
      "dependencies": [],
      "source_refs": [
        {
          "scope_id": "page:6",
          "page_index": 5,
          "page": 6,
          "bbox": [
