            457.41943359375
          ],
          "native_id": "native_p0001_ft000022"
        }
      ]
    },
    {
      "id": "block-855e4a9ca2f3369c6b69fc91",
      "type": "text",
      "text": "på land.",
      "level": 1,
      "parent_id": null,
      "numbering": "",
      "dependencies": [],
      "source_refs": [
        {
          "scope_id": "page:6",
          "page_index": 5,
          "page": 6,
          "bbox": [
